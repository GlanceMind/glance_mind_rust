# Database configuration
DATABASE_URL=postgres://aihub_user:aihub_password@localhost:5432/aihub_db

# API configuration
PORT=3000
JWT_SECRET=your-jwt-secret-key
REDIS_URL=redis://localhost:6379

# Email service
RESEND_API_KEY=your-resend-api-key

# AI services (timicc - text/chat)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://timicc.com/v1

# LaoZhang API (video/image generation only)
LAOZHANG_API_KEY=your-laozhang-api-key
LAOZHANG_BASE_URL=https://api.laozhang.ai
