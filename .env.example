# Database configuration
DATABASE_URL=postgres://aihub_user:aihub_password@localhost:5432/aihub_db

# API configuration
PORT=3000
JWT_SECRET=your-jwt-secret-key
REDIS_URL=redis://localhost:6379

# Email service
RESEND_API_KEY=your-resend-api-key

# AI services (LaoZhang OpenAI-compatible gateway - text/chat/video/image)
OPENAI_API_KEY=your-laozhang-api-key
OPENAI_BASE_URL=https://api.laozhang.ai/v1
AI_CHAT_MODEL=glm-5

# LaoZhang API (video/image generation)
LAOZHANG_API_KEY=your-laozhang-api-key
LAOZHANG_BASE_URL=https://api.laozhang.ai
