/**
 * 视频API简化集成测试
 * 
 * 测试目标：
 * 1. 测试TikHub客户端能否正常连接和调用
 * 2. 测试积分扣除逻辑
 * 3. 测试数据库任务记录
 */

use bigdecimal::BigDecimal;
use reqwest::multipart;
use serde_json::json;

#[tokio::test]
async fn test_tikhub_client_upload_image() {
    // 跳过如果没有配置环境变量
    dotenv::dotenv().ok();
    
    let api_key = match std::env::var("TIKHUB_API_KEY") {
        Ok(key) => key,
        Err(_) => {
            println!("⚠️  TIKHUB_API_KEY 未设置，跳过测试");
            return;
        }
    };
    
    let api_base_url = std::env::var("TIKHUB_API_BASE_URL")
        .unwrap_or_else(|_| "https://api.tikhub.io".to_string());
    
    println!("\n========== 测试TikHub图片上传 ==========");
    println!("API Base URL: {}", api_base_url);
    println!("API Key: {}...", &api_key[..20]);
    
    // 创建一个最小的PNG图片（1x1像素）
    let png_data = vec![
        0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
        0x00, 0x00, 0x00, 0x0D, 0x49, 0x48, 0x44, 0x52,
        0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01,
        0x08, 0x06, 0x00, 0x00, 0x00, 0x1F, 0x15, 0xC4,
        0x89, 0x00, 0x00, 0x00, 0x0A, 0x49, 0x44, 0x41,
        0x54, 0x78, 0x9C, 0x63, 0x00, 0x01, 0x00, 0x00,
        0x05, 0x00, 0x01, 0x0D, 0x0A, 0x2D, 0xB4, 0x00,
        0x00, 0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0xAE,
        0x42, 0x60, 0x82,
    ];
    
    // 构建multipart表单
    let form = multipart::Form::new()
        .part(
            "image",
            multipart::Part::bytes(png_data)
                .file_name("test.png")
                .mime_str("image/png")
                .unwrap(),
        );
    
    let client = reqwest::Client::new();
    let url = format!("{}/api/v1/sora2/upload_image", api_base_url);
    
    println!("→ 上传图片到: {}", url);
    
    let response = client
        .post(&url)
        .header("Authorization", format!("Bearer {}", api_key))
        .multipart(form)
        .send()
        .await;
    
    match response {
        Ok(resp) => {
            let status = resp.status();
            let body = resp.text().await.unwrap_or_else(|_| "无法读取响应体".to_string());
            
            println!("Response Status: {}", status);
            println!("Response Body: {}", body);
            
            if status.is_success() {
                if let Ok(json) = serde_json::from_str::<serde_json::Value>(&body) {
                    if let Some(media_id) = json["data"]["media_id"].as_str() {
                        println!("✓ 图片上传成功！");
                        println!("  Media ID: {}", media_id);
                    } else {
                        println!("⚠️  未能解析media_id: {:?}", json);
                    }
                }
            } else {
                println!("✗ 图片上传失败: {}", body);
            }
        }
        Err(e) => {
            println!("✗ 请求失败: {:?}", e);
            panic!("TikHub API请求失败");
        }
    }
    
    println!("========================================\n");
}

#[tokio::test]
async fn test_tikhub_client_create_video() {
    // 跳过如果没有配置环境变量
    dotenv::dotenv().ok();
    
    let api_key = match std::env::var("TIKHUB_API_KEY") {
        Ok(key) => key,
        Err(_) => {
            println!("⚠️  TIKHUB_API_KEY 未设置，跳过测试");
            return;
        }
    };
    
    let api_base_url = std::env::var("TIKHUB_API_BASE_URL")
        .unwrap_or_else(|_| "https://api.tikhub.io".to_string());
    
    println!("\n========== 测试TikHub视频生成 ==========");
    println!("API Base URL: {}", api_base_url);
    println!("API Key: {}...", &api_key[..20]);
    
    let body = json!({
        "prompt": "A cute cat playing with a ball of yarn"
    });
    
    let client = reqwest::Client::new();
    let url = format!("{}/api/v1/sora2/create_video", api_base_url);
    
    println!("→ 创建视频任务: {}", url);
    println!("  Prompt: {}", body["prompt"]);
    
    let response = client
        .post(&url)
        .header("Authorization", format!("Bearer {}", api_key))
        .header("Content-Type", "application/json")
        .json(&body)
        .send()
        .await;
    
    match response {
        Ok(resp) => {
            let status = resp.status();
            let body = resp.text().await.unwrap_or_else(|_| "无法读取响应体".to_string());
            
            println!("Response Status: {}", status);
            println!("Response Body: {}", body);
            
            if status.is_success() {
                if let Ok(json) = serde_json::from_str::<serde_json::Value>(&body) {
                    if let Some(task_id) = json["data"]["id"].as_str() {
                        println!("✓ 视频任务创建成功！");
                        println!("  Task ID: {}", task_id);
                        println!("  Status: {}", json["data"]["status"].as_str().unwrap_or("unknown"));
                    } else {
                        println!("⚠️  未能解析task_id: {:?}", json);
                    }
                }
            } else {
                println!("✗ 视频任务创建失败: {}", body);
            }
        }
        Err(e) => {
            println!("✗ 请求失败: {:?}", e);
            panic!("TikHub API请求失败");
        }
    }
    
    println!("========================================\n");
}

#[test]
fn test_bigdecimal_operations() {
    println!("\n========== 测试BigDecimal积分计算 ==========");
    
    let balance = BigDecimal::from(5000);
    let frozen = BigDecimal::from(0);
    let upload_cost = BigDecimal::from(10);
    let video_cost = BigDecimal::from(200);
    
    println!("初始余额: {}", balance);
    println!("冻结积分: {}", frozen);
    
    let available = &balance - &frozen;
    println!("可用余额: {}", available);
    
    // 测试上传图片扣费
    let after_upload = &balance - &upload_cost;
    println!("上传图片后余额: {}", after_upload);
    
    // 测试视频生成冻结
    let after_freeze = &frozen + &video_cost;
    println!("冻结视频费用后: {}", after_freeze);
    
    let available_after = &after_upload - &after_freeze;
    println!("最终可用余额: {}", available_after);
    
    assert_eq!(available_after, BigDecimal::from(4790));
    
    println!("✓ 积分计算测试通过");
    println!("========================================\n");
}
