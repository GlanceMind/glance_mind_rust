/// LaoZhang Client 单元测试
///
/// 这些测试用例覆盖了 LaoZhang.ai API 的所有功能：
/// 1. 文生视频
/// 2. 图生视频
/// 3. 查询任务状态
/// 4. 下载视频
///
/// 注意：这些测试不会实际运行，仅作为示例代码

#[cfg(test)]
mod laozhang_client_tests {
    use glance_mind_api::dto::laozhang_dto::{
        CreateVideoFromImageRequest, CreateVideoFromTextRequest, VideoTaskDetailResponse,
    };
    use glance_mind_api::service::laozhang_client::LaoZhangClient;

    /// 辅助函数：创建测试用的 LaoZhang Client
    fn create_test_client() -> LaoZhangClient {
        LaoZhangClient::new(
            std::env::var("LAOZHANG_API_KEY").unwrap_or_else(|_| "test_key".to_string()),
            Some("https://api.laozhang.ai".to_string()),
        )
    }

    /// 测试：Client 初始化
    #[test]
    fn test_client_initialization() {
        let client = LaoZhangClient::new(
            "my_api_key".to_string(),
            Some("https://api.laozhang.ai".to_string()),
        );

        // 验证 URL 生成
        let video_url = client.get_video_url("video_123");
        assert_eq!(video_url, "/v1/videos/video_123/content");

        let full_url = client.get_full_video_url("video_123");
        assert_eq!(
            full_url,
            "https://api.laozhang.ai/v1/videos/video_123/content"
        );
    }

    /// 测试：默认 base_url
    #[test]
    fn test_client_default_base_url() {
        let client = LaoZhangClient::new("test_key".to_string(), None);
        let full_url = client.get_full_video_url("video_abc");
        assert_eq!(
            full_url,
            "https://api.laozhang.ai/v1/videos/video_abc/content"
        );
    }

    /// 测试：CreateVideoFromTextRequest 默认值
    #[test]
    fn test_create_video_from_text_request_defaults() {
        let request = CreateVideoFromTextRequest::default();

        assert_eq!(request.model, "sora-2");
        assert_eq!(request.size, "1280x720");
        assert_eq!(request.seconds, "15");
        assert!(request.prompt.is_empty());
    }

    /// 测试：CreateVideoFromTextRequest 自定义值
    #[test]
    fn test_create_video_from_text_request_custom() {
        let request = CreateVideoFromTextRequest {
            model: "sora-2".to_string(),
            prompt: "一只可爱的猫咪在阳光明媚的花园里玩球".to_string(),
            size: "1920x1080".to_string(),
            seconds: "20".to_string(),
        };

        assert_eq!(request.model, "sora-2");
        assert_eq!(request.prompt, "一只可爱的猫咪在阳光明媚的花园里玩球");
        assert_eq!(request.size, "1920x1080");
        assert_eq!(request.seconds, "20");
    }

    /// 测试：CreateVideoFromImageRequest 默认值
    #[test]
    fn test_create_video_from_image_request_defaults() {
        let request = CreateVideoFromImageRequest::default();

        assert_eq!(request.model, "sora-2");
        assert_eq!(request.size, "1280x720");
        assert_eq!(request.seconds, "10");
        assert_eq!(request.image_filename, "image.png");
        assert!(request.prompt.is_empty());
        assert!(request.image_data.is_empty());
    }

    /// 测试：CreateVideoFromImageRequest 自定义值
    #[test]
    fn test_create_video_from_image_request_custom() {
        let image_data = vec![0x89, 0x50, 0x4E, 0x47]; // PNG 魔术字节
        let request = CreateVideoFromImageRequest {
            model: "sora-2".to_string(),
            prompt: "让这张图片中的场景动起来".to_string(),
            image_data: image_data.clone(),
            image_filename: "test.png".to_string(),
            size: "1280x720".to_string(),
            seconds: "15".to_string(),
        };

        assert_eq!(request.model, "sora-2");
        assert_eq!(request.image_data, image_data);
        assert_eq!(request.image_filename, "test.png");
        assert_eq!(request.seconds, "15");
    }

    /// 测试：VideoTaskDetailResponse 状态检查方法
    #[test]
    fn test_video_task_detail_status_checks() {
        // 测试 completed 状态
        let completed_task = VideoTaskDetailResponse {
            id: "video_123".to_string(),
            object: "video".to_string(),
            model: "sora-2".to_string(),
            status: "completed".to_string(),
            progress: Some(100),
            url: Some("/v1/videos/video_123/content".to_string()),
            created_at: 1760945092,
            completed_at: Some(1760945379),
            error: None,
        };

        assert!(completed_task.is_completed());
        assert!(!completed_task.is_failed());
        assert!(!completed_task.is_processing());
        assert_eq!(
            completed_task.get_download_url(),
            Some("/v1/videos/video_123/content")
        );

        // 测试 in_progress 状态
        let in_progress_task = VideoTaskDetailResponse {
            id: "video_456".to_string(),
            object: "video".to_string(),
            model: "sora-2".to_string(),
            status: "in_progress".to_string(),
            progress: Some(65),
            url: None,
            created_at: 1760945092,
            completed_at: None,
            error: None,
        };

        assert!(!in_progress_task.is_completed());
        assert!(!in_progress_task.is_failed());
        assert!(in_progress_task.is_processing());
        assert_eq!(in_progress_task.get_download_url(), None);

        // 测试 submitted 状态
        let submitted_task = VideoTaskDetailResponse {
            id: "video_789".to_string(),
            object: "task".to_string(),
            model: "sora-2".to_string(),
            status: "submitted".to_string(),
            progress: None,
            url: None,
            created_at: 1760945092,
            completed_at: None,
            error: None,
        };

        assert!(!submitted_task.is_completed());
        assert!(!submitted_task.is_failed());
        assert!(submitted_task.is_processing());

        // 测试 failed 状态
        let failed_task = VideoTaskDetailResponse {
            id: "video_999".to_string(),
            object: "video".to_string(),
            model: "sora-2".to_string(),
            status: "failed".to_string(),
            progress: Some(0),
            url: None,
            created_at: 1760945092,
            completed_at: None,
            error: Some("处理失败".to_string()),
        };

        assert!(!failed_task.is_completed());
        assert!(failed_task.is_failed());
        assert!(!failed_task.is_processing());
    }

    /// 集成测试：文生视频完整流程（手动测试）
    ///
    /// 这个测试展示了如何使用 LaoZhang Client 进行文生视频的完整流程：
    /// 1. 创建视频任务
    /// 2. 轮询查询任务状态
    /// 3. 下载完成的视频
    ///
    /// 运行方式:
    /// export LAOZHANG_API_KEY="your_api_key"
    /// cargo test test_create_video_from_text_integration -- --ignored --nocapture
    #[tokio::test]
    #[ignore] // 标记为 ignore，避免在 CI 中运行
    async fn test_create_video_from_text_integration() {
        let client = create_test_client();

        // 步骤 1: 创建文生视频任务（使用 ai_call.md 中的参数）
        let request = CreateVideoFromTextRequest {
            model: "sora-2".to_string(),
            prompt: "一只可爱的猫咪在阳光明媚的花园里玩球".to_string(),
            size: "1280x720".to_string(),
            seconds: "15".to_string(),
        };

        println!("\n╔══════════════════════════════════════════════════════════╗");
        println!("║  📹 测试：文生视频完整流程                                ║");
        println!("╚══════════════════════════════════════════════════════════╝\n");

        println!("📝 请求参数:");
        println!("  - model: {}", request.model);
        println!("  - prompt: {}", request.prompt);
        println!("  - size: {}", request.size);
        println!("  - seconds: {}", request.seconds);

        println!("\n🚀 步骤 1: 创建文生视频任务...");
        let task_response = client.create_video_from_text(request).await.unwrap();
        println!("✅ 任务创建成功!");
        println!("  - task_id: {}", task_response.id);
        println!("  - status: {}", task_response.status);
        println!("  - model: {}", task_response.model);

        assert_eq!(task_response.object, "task");
        assert_eq!(task_response.model, "sora-2");
        assert_eq!(task_response.status, "submitted");

        // 步骤 2: 轮询查询任务状态
        println!("\n步骤 2: 查询任务状态...");
        let task_id = task_response.id;
        let mut attempts = 0;
        let max_attempts = 60; // 最多等待 5 分钟（60 * 5 秒）

        loop {
            attempts += 1;
            let status = client.get_task_status(&task_id).await.unwrap();

            println!(
                "尝试 {}/{}: status={}, progress={:?}",
                attempts, max_attempts, status.status, status.progress
            );

            if status.is_completed() {
                println!("✅ 视频生成完成！");
                assert_eq!(status.progress, Some(100));
                assert!(status.url.is_some());
                break;
            } else if status.is_failed() {
                println!("❌ 视频生成失败: {:?}", status.error);
                panic!("视频生成失败");
            }

            if attempts >= max_attempts {
                println!("⚠️  超时：超过最大尝试次数");
                break;
            }

            // 等待 5 秒后重试
            tokio::time::sleep(tokio::time::Duration::from_secs(5)).await;
        }

        // 步骤 3: 下载视频
        println!("\n步骤 3: 下载视频...");
        let video_data = client.download_video(&task_id).await.unwrap();
        println!("视频下载成功: size={} bytes", video_data.len());

        assert!(!video_data.is_empty());

        // 可选：保存到文件
        // std::fs::write("test_video.mp4", video_data).unwrap();
    }

    /// 集成测试：图生视频完整流程（不实际运行）
    #[tokio::test]
    #[ignore]
    async fn test_create_video_from_image_integration() {
        let client = create_test_client();

        // 步骤 1: 准备测试图片（1x1 透明 PNG）
        let test_image = vec![
            0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49, 0x48,
            0x44, 0x52, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x08, 0x06, 0x00, 0x00,
            0x00, 0x1F, 0x15, 0xC4, 0x89, 0x00, 0x00, 0x00, 0x0A, 0x49, 0x44, 0x41, 0x54, 0x78,
            0x9C, 0x63, 0x00, 0x01, 0x00, 0x00, 0x05, 0x00, 0x01, 0x0D, 0x0A, 0x2D, 0xB4, 0x00,
            0x00, 0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0xAE, 0x42, 0x60, 0x82,
        ];

        // 步骤 2: 创建图生视频任务
        let request = CreateVideoFromImageRequest {
            model: "sora-2".to_string(),
            prompt: "让这张图片中的场景动起来，增加自然的动态效果".to_string(),
            image_data: test_image,
            image_filename: "test.png".to_string(),
            size: "1280x720".to_string(),
            seconds: "10".to_string(),
        };

        println!("步骤 1: 创建图生视频任务...");
        let task_response = client.create_video_from_image(request).await.unwrap();
        println!("任务创建成功: task_id={}", task_response.id);

        assert_eq!(task_response.object, "task");
        assert_eq!(task_response.model, "sora-2");
        assert_eq!(task_response.status, "submitted");

        // 步骤 3: 查询任务状态
        println!("\n步骤 2: 查询任务状态...");
        let task_id = task_response.id;
        let status = client.get_task_status(&task_id).await.unwrap();

        println!(
            "任务状态: status={}, progress={:?}",
            status.status, status.progress
        );
        assert!(status.is_processing() || status.is_completed());
    }

    /// 单元测试：仅测试查询任务状态（不实际运行）
    #[tokio::test]
    #[ignore]
    async fn test_get_task_status_only() {
        let client = create_test_client();
        let task_id = "video_abc123"; // 假设的任务 ID

        println!("查询任务状态: task_id={}", task_id);
        let result = client.get_task_status(task_id).await;

        match result {
            Ok(status) => {
                println!("✅ 查询成功:");
                println!("  - status: {}", status.status);
                println!("  - progress: {:?}", status.progress);
                println!("  - url: {:?}", status.url);
            }
            Err(e) => {
                println!("❌ 查询失败: {:?}", e);
            }
        }
    }

    /// 单元测试：仅测试下载视频（不实际运行）
    #[tokio::test]
    #[ignore]
    async fn test_download_video_only() {
        let client = create_test_client();
        let task_id = "video_abc123"; // 假设的任务 ID

        println!("下载视频: task_id={}", task_id);
        let result = client.download_video(task_id).await;

        match result {
            Ok(video_data) => {
                println!("✅ 下载成功: size={} bytes", video_data.len());
                assert!(!video_data.is_empty());

                // 可选：保存到文件
                // std::fs::write("downloaded_video.mp4", video_data).unwrap();
            }
            Err(e) => {
                println!("❌ 下载失败: {:?}", e);
            }
        }
    }

    /// 性能测试：并发创建多个视频任务（不实际运行）
    #[tokio::test]
    #[ignore]
    async fn test_concurrent_video_creation() {
        let client = create_test_client();
        let mut tasks = vec![];

        // 创建 5 个并发任务
        for i in 0..5 {
            let client_clone = client.clone();
            let task = tokio::spawn(async move {
                let request = CreateVideoFromTextRequest {
                    model: "sora-2".to_string(),
                    prompt: format!("测试视频 #{}", i),
                    size: "1280x720".to_string(),
                    seconds: "10".to_string(),
                };

                client_clone.create_video_from_text(request).await
            });
            tasks.push(task);
        }

        // 等待所有任务完成
        let mut results = vec![];
        for task in tasks {
            let result = task.await;
            results.push(result);
        }

        println!("并发创建了 {} 个任务", results.len());
        for (i, result) in results.iter().enumerate() {
            match result {
                Ok(Ok(response)) => {
                    println!("任务 {} 创建成功: task_id={}", i, response.id);
                }
                _ => {
                    println!("任务 {} 创建失败", i);
                }
            }
        }
    }
}
