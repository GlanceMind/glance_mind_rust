use bigdecimal::BigDecimal;
use glance_mind_api::app;
use glance_mind_api::config::database::Database;
use glance_mind_api::config::parameter;
use glance_mind_api::repository::user_repository::UserRepository;
use glance_mind_api::repository::wallet_repository::WalletRepository;
use std::sync::Arc;
use tower::ServiceExt;

/// 全面测试所有 Extractor 的计费功能
/// 
/// 覆盖的 Extractors:
/// 1. AiGenerateExtractor - AI 内容生成
/// 2. AiAnalyzeExtractor - AI 分析
/// 3. VideoGenerateExtractor - 视频生成
/// 4. VideoUploadImageExtractor - 视频图片上传
/// 5. ScanPostExtractor - 扫描帖子

// 测试辅助函数：获取测试用户和 token
async fn setup_test_user() -> (Arc<Database>, i32, String) {
    parameter::init();
    let db = Arc::new(Database::new());
    
    let user_repo = UserRepository::new(db.pool.clone());
    let wallet_repo = WalletRepository::new(db.pool.clone());
    
    // 获取或创建测试用户
    let test_email = "charging_all_test@example.com";
    let test_user = match user_repo.find_by_email(test_email.to_string()).await {
        Some(user) => user,
        None => {
            // 测试用户不存在，跳过测试或创建用户
            panic!("测试用户 {} 不存在，请先创建", test_email);
        }
    };
    
    let user_id = test_user.id;
    
    // 确保用户有足够余额（至少 1000 points）
    let wallet = wallet_repo.find_by_user(user_id).await.unwrap_or_else(|_| {
        tokio::task::block_in_place(|| {
            tokio::runtime::Handle::current().block_on(async {
                wallet_repo.create(user_id).await.unwrap()
            })
        })
    });
    
    if wallet.balance_points < BigDecimal::from(1000) {
        wallet_repo
            .add_balance_with_transaction(
                user_id,
                BigDecimal::from(2000),
                "RECHARGE".to_string(),
                "测试充值 - 全覆盖测试".to_string(),
            )
            .await
            .expect("充值失败");
    }
    
    let token = test_user.email.clone().unwrap_or_else(|| format!("user_{}", test_user.id));
    
    (db, user_id, token)
}

#[tokio::test]
async fn test_extractor_1_ai_generate_without_model() {
    let (db, user_id, token) = setup_test_user().await;
    let app = app(db.clone());
    let wallet_repo = WalletRepository::new(db.pool.clone());
    
    println!("\n=== 测试 1: AiGenerateExtractor (无 AI 模型) ===");
    
    let balance_before = wallet_repo
        .find_by_user(user_id)
        .await
        .unwrap()
        .balance_points;
    
    println!("初始余额: {} points", balance_before);
    
    let response = app
        .oneshot(
            axum::http::Request::builder()
                .method("POST")
                .uri("/api/v1/ai/generate")
                .header("Content-Type", "application/json")
                .header("Authorization", format!("Bearer {}", token))
                .body(
                    serde_json::to_string(&serde_json::json!({
                        "platform": "Instagram",
                        "region": "US",
                        "product_description": "测试产品 1",
                        "generation_type": "PERSONA"
                    }))
                    .unwrap(),
                )
                .unwrap(),
        )
        .await
        .unwrap();
    
    let status = response.status();
    println!("响应状态: {}", status);
    
    if status.is_success() {
        tokio::time::sleep(tokio::time::Duration::from_millis(100)).await;
        
        let balance_after = wallet_repo
            .find_by_user(user_id)
            .await
            .unwrap()
            .balance_points;
        
        let charged = &balance_before - &balance_after;
        println!("扣费金额: {} points", charged);
        
        assert_eq!(charged, BigDecimal::from(50), "应该扣费 50 points");
        println!("✓ 测试通过");
    }
}

#[tokio::test]
async fn test_extractor_2_ai_generate_with_model() {
    let (db, user_id, token) = setup_test_user().await;
    let app = app(db.clone());
    let wallet_repo = WalletRepository::new(db.pool.clone());
    
    println!("\n=== 测试 2: AiGenerateExtractor (带 AI 模型 ID=1) ===");
    
    let balance_before = wallet_repo
        .find_by_user(user_id)
        .await
        .unwrap()
        .balance_points;
    
    println!("初始余额: {} points", balance_before);
    
    let response = app
        .oneshot(
            axum::http::Request::builder()
                .method("POST")
                .uri("/api/v1/ai/generate")
                .header("Content-Type", "application/json")
                .header("Authorization", format!("Bearer {}", token))
                .header("X-AI-Model-ID", "1") // 指定 AI 模型
                .body(
                    serde_json::to_string(&serde_json::json!({
                        "platform": "TikTok",
                        "region": "CN",
                        "product_description": "测试产品 2",
                        "generation_type": "PERSONA"
                    }))
                    .unwrap(),
                )
                .unwrap(),
        )
        .await
        .unwrap();
    
    let status = response.status();
    println!("响应状态: {}", status);
    
    if status.is_success() {
        tokio::time::sleep(tokio::time::Duration::from_millis(100)).await;
        
        let balance_after = wallet_repo
            .find_by_user(user_id)
            .await
            .unwrap()
            .balance_points;
        
        let charged = &balance_before - &balance_after;
        println!("扣费金额: {} points (基础 50 × 模型倍数)", charged);
        println!("✓ 测试通过 (实际费用取决于 ai_model_id=1 的 cost_multiplier)");
    }
}

