# Database Configuration
DATABASE_URL=postgres://aihub_user:aihub_password@localhost:5432/aihub_db

# Server Configuration
PORT=8000
JWT_SECRET=your_jwt_secret_key_here

# DeepSeek OpenAI-compatible runtime for AI assistant chat and reply-template generation
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LaoZhang API Configuration (for AI video/image generation only)
LAOZHANG_API_KEY=your_laozhang_api_key_here
LAOZHANG_BASE_URL=https://api.laozhang.ai

# XunhuPay Recharge Configuration
# Gateway can be either:
#   - root host: https://api.xunhupay.com
#   - full pay endpoint: https://api.xunhupay.com/payment/do.html
XUNHUPAY_APP_ID=your_xunhupay_app_id
XUNHUPAY_APP_SECRET=your_xunhupay_app_secret
XUNHUPAY_GATEWAY_URL=https://api.xunhupay.com
API_BASE_URL=https://glancemind.org

# Rust Log Level
RUST_LOG=info

# Telegram internal notifications (optional — leave blank to disable).
# Bot token from @BotFather; chat id of the internal channel (negative for channels).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
