# Database Configuration
DATABASE_URL=postgres://aihub_user:aihub_password@localhost:5432/aihub_db

# Server Configuration
PORT=8000
JWT_SECRET=your_jwt_secret_key_here

# AI API Configuration (timicc - used by AI chat, ai_service, agent_analysis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://timicc.com/v1

# LaoZhang API Configuration (for AI video/image generation only)
LAOZHANG_API_KEY=your_laozhang_api_key_here
LAOZHANG_BASE_URL=https://api.laozhang.ai

# Rust Log Level
RUST_LOG=info
